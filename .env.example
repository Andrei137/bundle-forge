# docker compose env — copy to .env and fill in
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=bundle-forge
DB_USER=bundle-forge-admin
DB_PASS=<YOUR_DB_PASS>

JWT_SECRET=<YOUR_JWT_SECRET>

# Redis (defaults to the bundleforge-redis container; override to use an external instance)
REDIS_HOST=redis
REDIS_PORT=6379

# Stripe
STRIPE_API_KEY=<YOUR_STRIPE_API_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# Frontend
VITE_API_URL=http://localhost:8080
VITE_STRIPE_PUBLISHABLE_KEY=<YOUR_VITE_STRIPE_PUBLISHABLE_KEY>

# Comma-separated origins the backend will accept
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
