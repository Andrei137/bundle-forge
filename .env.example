# MySQL
MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
DB_NAME=bundle-forge
DB_USER=bundle-forge
DB_PASS=<YOUR_DB_PASS>

# Backend
JWT_SECRET=<YOUR_JWT_SECRET>

# Stripe
STRIPE_API_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# Comma-separated origins the backend will accept for CORS.
# Include the host where you open the frontend in the browser.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend
VITE_API_URL=http://localhost:8080
VITE_STRIPE_PUBLISHABLE_KEY=<YOUR_VITE_STRIPE_PUBLISHABLE_KEY>
