meta {
  name: Announce
  type: http
  seq: 2
}

post {
  url: {{url}}/games
  body: multipartForm
  auth: inherit
}

body:json {
  {
    "title": "Hollow Knight",
    "price": 12.99
  }
}

body:multipart-form {
  game: '''
    {
      "title": "Sword of the 42223",
      "price": 12.99,
      "description": "ceva",
      "systemRequirements": {
        "linux": {
            "minimum": {
                "os": "Ubuntu 20.04 / Steamos 3.0",
                "note": "Requires a 64-bit processor and operating system",
                "memory": "16 GB RAM",
                "storage": "40 GB available space",
                "graphics": "NVIDIA GeForce GTX 1660 6 GB / Radeon RX 5500 XT 8 GB",
                "processor": "Intel Core i5-8500 / AMD Ryzen 5 3500",
                "graphicsAPI": "Vulkan API Version 1.3"
            },
            "recommended": {
                "os": "Ubuntu 22.04 / Steamos 3.4+",
                "note": "Requires a 64-bit processor and operating system",
                "memory": "16 GB RAM",
                "storage": "40 GB available space (SSD)",
                "graphics": "NVIDIA GeForce RTX 2060 Super 8GB / Radeon RX 6600 8GB",
                "processor": "Intel Core i7-8700 / AMD Ryzen 5 5500",
                "graphicsAPI": "Vulkan API Version 1.3"
            }
        },
        "windows": {
            "minimum": {
                "os": "Windows 11 (64 bit)",
                "note": "Requires a 64-bit processor and operating system",
                "memory": "16 GB RAM",
                "storage": "40 GB available space",
                "graphics": "NVIDIA GeForce GTX 1660 6 GB / Radeon RX 5500 XT 8 GB",
                "processor": "Intel Core i5-8500 / AMD Ryzen 5 3500",
                "graphicsAPI": "DirectX Version 12"
            },
            "recommended": {
                "os": "Windows 11 (64 bit)",
                "note": "Requires a 64-bit processor and operating system",
                "memory": "16 GB RAM",
                "storage": "40 GB available space",
                "graphics": "NVIDIA GeForce RTX 2060 Super 8GB / Radeon RX 6600 8GB",
                "processor": "Intel Core i7-8700 / AMD Ryzen 5 5500",
                "graphicsAPI": "DirectX Version 12"
            }
        }
      }
    }
  ''' @contentType(application/json)
  cover: @file(/home/seb/Downloads/build-your-own-killer-bundle.jpeg)
  images: @file(/home/seb/Downloads/build-your-own-exodus-bundle.jpeg)
}

settings {
  encodeUrl: true
  timeout: 0
}
